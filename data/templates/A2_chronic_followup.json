{
  "id": "A2",
  "name": "Chronic Disease Follow-Up",
  "description": "Return visit for ongoing management of established chronic conditions",
  "sections": [
    {
      "id": "chief_complaint",
      "label": "Reason for Visit",
      "abn_key": "cc",
      "fields": [
        {
          "id": "cc_text",
          "label": "Reason for Visit",
          "type": "textarea",
          "rows": 2,
          "abn_key": "cc",
          "placeholder": "Primary reason for today's follow-up"
        }
      ]
    },
    {
      "id": "interval",
      "label": "Interval History",
      "abn_key": "interval",
      "fields": [
        {
          "id": "interval_text",
          "label": "Since Last Visit",
          "type": "textarea",
          "rows": 3,
          "abn_key": "interval",
          "placeholder": "Changes in symptoms, new complaints, hospital visits, ER visits since last visit"
        }
      ]
    },
    {
      "id": "problem_list",
      "label": "Active Problem List",
      "abn_key": "pmh",
      "fields": [
        {
          "id": "problems",
          "label": "Active Conditions",
          "type": "textarea",
          "rows": 3,
          "abn_key": "pmh",
          "placeholder": "Current active diagnoses being managed"
        }
      ]
    },
    {
      "id": "disease_metrics",
      "label": "Disease-Specific Metrics",
      "abn_key": "labs",
      "fields": [
        {
          "id": "last_a1c",
          "label": "Last A1C / Date",
          "type": "text",
          "abn_key": null,
          "placeholder": "e.g. 7.2% (03/2026)"
        },
        {
          "id": "last_lipids",
          "label": "Last Lipid Panel / Date",
          "type": "text",
          "abn_key": null,
          "placeholder": "LDL / HDL / TG"
        },
        {
          "id": "last_labs",
          "label": "Other Recent Labs",
          "type": "text",
          "abn_key": "labs",
          "placeholder": "BMP, CBC, TSH, etc."
        },
        {
          "id": "med_compliance",
          "label": "Medication Compliance",
          "type": "select",
          "options": ["Compliant", "Partially compliant", "Non-compliant", "Not assessed"],
          "abn_key": null
        }
      ]
    },
    {
      "id": "medications",
      "label": "Medications / Changes",
      "abn_key": "meds",
      "fields": [
        {
          "id": "med_list",
          "label": "Current Medications",
          "type": "textarea",
          "rows": 3,
          "abn_key": "meds",
          "placeholder": "List current medications. Note any changes from last visit."
        },
        {
          "id": "refills",
          "label": "Refills Requested",
          "type": "text",
          "abn_key": null,
          "placeholder": "Medications needing refills"
        }
      ]
    },
    {
      "id": "vitals",
      "label": "Vital Signs",
      "abn_key": "vitals",
      "fields": [
        {
          "id": "bp",
          "label": "BP",
          "type": "text",
          "abn_key": "vitals.bp",
          "placeholder": "e.g. 128/76"
        },
        {
          "id": "hr",
          "label": "HR",
          "type": "text",
          "abn_key": "vitals.hr",
          "placeholder": "bpm"
        },
        {
          "id": "weight",
          "label": "Weight",
          "type": "text",
          "abn_key": "vitals.weight",
          "placeholder": "lbs / kg"
        },
        {
          "id": "o2sat",
          "label": "O2 Sat",
          "type": "text",
          "abn_key": "vitals.o2sat",
          "placeholder": "%"
        },
        {
          "id": "temp",
          "label": "Temp",
          "type": "text",
          "abn_key": "vitals.temp",
          "placeholder": "°F"
        }
      ]
    },
    {
      "id": "exam",
      "label": "Focused Physical Exam",
      "abn_key": "exam",
      "fields": [
        {
          "id": "general",
          "label": "General",
          "type": "text",
          "abn_key": "exam.general",
          "placeholder": "General appearance"
        },
        {
          "id": "cardiovascular",
          "label": "Cardiovascular",
          "type": "text",
          "abn_key": "exam.cv",
          "placeholder": "Heart exam"
        },
        {
          "id": "respiratory",
          "label": "Respiratory",
          "type": "text",
          "abn_key": "exam.resp",
          "placeholder": "Lung exam"
        },
        {
          "id": "extremities",
          "label": "Extremities",
          "type": "text",
          "abn_key": "exam.ext",
          "placeholder": "Edema, pulses"
        }
      ]
    },
    {
      "id": "assessment",
      "label": "Assessment",
      "abn_key": "assessment",
      "fields": [
        {
          "id": "assessment_text",
          "label": "Assessment per Problem",
          "type": "textarea",
          "rows": 4,
          "abn_key": "assessment",
          "placeholder": "1. [Condition] - [status / change]\n2. [Condition] - [status / change]"
        }
      ]
    },
    {
      "id": "plan",
      "label": "Plan",
      "abn_key": "plan",
      "fields": [
        {
          "id": "plan_text",
          "label": "Plan per Problem",
          "type": "textarea",
          "rows": 4,
          "abn_key": "plan",
          "placeholder": "1. [Condition] - [action]\n2. [Condition] - [action]"
        }
      ]
    },
    {
      "id": "followup",
      "label": "Follow-Up",
      "abn_key": "followup",
      "fields": [
        {
          "id": "followup_text",
          "label": "Return Interval",
          "type": "text",
          "abn_key": "followup",
          "placeholder": "Return to clinic in ___ weeks/months"
        },
        {
          "id": "labs_ordered",
          "label": "Labs / Studies Ordered",
          "type": "text",
          "abn_key": null,
          "placeholder": "Labs to order before next visit"
        }
      ]
    }
  ]
}
