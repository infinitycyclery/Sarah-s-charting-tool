{
  "id": "A4",
  "name": "Mental Health / Behavioral SOAP",
  "description": "Psychiatry or behavioral health progress note with full mental status exam",
  "sections": [
    {
      "id": "chief_complaint",
      "label": "Presenting Concern",
      "abn_key": "cc",
      "fields": [
        {
          "id": "cc_text",
          "label": "Presenting Concern",
          "type": "textarea",
          "rows": 2,
          "abn_key": "cc",
          "placeholder": "Patient's primary concern in their own words"
        }
      ]
    },
    {
      "id": "interval",
      "label": "Interval History",
      "abn_key": "interval",
      "fields": [
        {
          "id": "interval_text",
          "label": "Since Last Session",
          "type": "textarea",
          "rows": 3,
          "abn_key": "interval",
          "placeholder": "Significant events, stressors, symptom changes, medication response since last visit"
        }
      ]
    },
    {
      "id": "medications",
      "label": "Medications & Compliance",
      "abn_key": "meds",
      "fields": [
        {
          "id": "med_list",
          "label": "Psychiatric Medications",
          "type": "textarea",
          "rows": 3,
          "abn_key": "meds",
          "placeholder": "List medications with dose, frequency, and compliance"
        },
        {
          "id": "side_effects",
          "label": "Side Effects Reported",
          "type": "text",
          "abn_key": null,
          "placeholder": "None reported / describe"
        }
      ]
    },
    {
      "id": "mse",
      "label": "Mental Status Exam",
      "abn_key": "mse",
      "fields": [
        {
          "id": "appearance",
          "label": "Appearance",
          "type": "text",
          "abn_key": null,
          "placeholder": "Grooming, hygiene, dress, eye contact"
        },
        {
          "id": "behavior",
          "label": "Behavior / Psychomotor",
          "type": "text",
          "abn_key": null,
          "placeholder": "Cooperative, agitated, psychomotor retardation/agitation"
        },
        {
          "id": "speech",
          "label": "Speech",
          "type": "text",
          "abn_key": null,
          "placeholder": "Rate, volume, tone, fluency"
        },
        {
          "id": "mood",
          "label": "Mood",
          "type": "text",
          "abn_key": null,
          "placeholder": "Patient's self-reported mood (in quotes)"
        },
        {
          "id": "affect",
          "label": "Affect",
          "type": "text",
          "abn_key": null,
          "placeholder": "Observed affect: euthymic, blunted, flat, labile, constricted, expansive"
        },
        {
          "id": "thought_process",
          "label": "Thought Process",
          "type": "text",
          "abn_key": null,
          "placeholder": "Linear, goal-directed, tangential, circumstantial, disorganized, flight of ideas"
        },
        {
          "id": "thought_content",
          "label": "Thought Content",
          "type": "text",
          "abn_key": null,
          "placeholder": "Preoccupations, obsessions, delusions, paranoia"
        },
        {
          "id": "perception",
          "label": "Perceptions",
          "type": "text",
          "abn_key": null,
          "placeholder": "Hallucinations (AVH), illusions, depersonalization"
        },
        {
          "id": "cognition",
          "label": "Cognition",
          "type": "text",
          "abn_key": null,
          "placeholder": "Orientation, memory, concentration, insight, judgment"
        },
        {
          "id": "insight",
          "label": "Insight / Judgment",
          "type": "text",
          "abn_key": null,
          "placeholder": "Good, fair, poor"
        }
      ]
    },
    {
      "id": "risk",
      "label": "Risk Assessment",
      "abn_key": "risk",
      "fields": [
        {
          "id": "si_hi",
          "label": "SI / HI",
          "type": "text",
          "abn_key": "risk",
          "placeholder": "Denies SI/HI, or describe ideation, plan, intent, means"
        },
        {
          "id": "self_harm",
          "label": "Self-Harm / Harm to Others",
          "type": "text",
          "abn_key": null,
          "placeholder": "Current or recent self-harm behavior"
        },
        {
          "id": "protective_factors",
          "label": "Protective Factors",
          "type": "text",
          "abn_key": null,
          "placeholder": "Future orientation, social support, reasons for living"
        },
        {
          "id": "overall_risk",
          "label": "Overall Risk Level",
          "type": "select",
          "options": ["Low", "Moderate", "High", "Imminent"],
          "abn_key": null
        }
      ]
    },
    {
      "id": "assessment",
      "label": "Assessment / Diagnosis",
      "abn_key": "assessment",
      "fields": [
        {
          "id": "assessment_text",
          "label": "DSM-5 Diagnosis",
          "type": "textarea",
          "rows": 3,
          "abn_key": "assessment",
          "placeholder": "1. [Diagnosis] - [ICD-10 code] - [status]\n2. [Diagnosis] - [ICD-10 code] - [status]"
        }
      ]
    },
    {
      "id": "plan",
      "label": "Treatment Plan",
      "abn_key": "plan",
      "fields": [
        {
          "id": "plan_text",
          "label": "Plan",
          "type": "textarea",
          "rows": 4,
          "abn_key": "plan",
          "placeholder": "Medication changes, therapy modalities, referrals, safety plan, psychoeducation"
        },
        {
          "id": "followup_text",
          "label": "Next Appointment",
          "type": "text",
          "abn_key": "followup",
          "placeholder": "Return in ___ weeks for ___"
        }
      ]
    }
  ]
}
